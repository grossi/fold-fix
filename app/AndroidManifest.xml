<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.foldfix"
    android:versionCode="3"
    android:versionName="1.0.2">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />

    <!-- directBootAware: the fix must also work on the lock screen right after a reboot.
         hardwareAccelerated="false": every window of FoldFix is drawn in software, the landscape
         fix's overlay included, so the process the service runs in never uses the GPU. A GPU fault
         aborts the whole process, and a GPU that hangs blocks the service's main thread
         ("Drawn in software" in docs/how-it-works.md). Android's text magnifier and its long
         screenshots ignore this setting and use the GPU in the app's process, so the status
         screen has no selectable text and is excluded from scroll capture (see MainActivity). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:directBootAware="true"
        android:hardwareAccelerated="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldFix">

        <!-- The system's WindowManager extensions (rear-display sessions); optional, see RearDisplay. -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible: starts or ends rear-display mode, which only the top app may do.
             Exported only to holders of DUMP, i.e. the adb shell (for testing); apps can't get
             DUMP unless it is granted over adb. FoldFix itself can always start its own activity. -->
        <activity
            android:name=".Trampoline"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="app.foldfix.trampoline"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.FoldFix.Invisible" />

        <!-- Black screen that ends the request Pixel Camera makes right after FoldFix ended its own
             on open, and covers Camera for a moment (see Curtain). Only FoldFix starts it. -->
        <activity
            android:name=".Curtain"
            android:directBootAware="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="app.foldfix.curtain"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.FoldFix.Curtain" />

        <!-- Test hook: makes the service act on a simulated hall reading (see HallOverride).
             Like the trampoline, exported only to holders of DUMP: the adb shell and privileged
             system apps, and any other app only if DUMP is granted to it over adb. -->
        <receiver
            android:name=".HallOverride"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".FoldService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
